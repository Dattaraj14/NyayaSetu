# ============================================================
# NyayaSetu Configuration
# ============================================================

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nyayasetu
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/nyayasetu

# LLM Configuration
LLM_PROVIDER=gemini
# Options: local, gemini, openai, groq
LLM_MODEL=gemini-2.0-flash
# For local: path to GGUF model file
LOCAL_LLM_MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf
LOCAL_LLM_N_GPU_LAYERS=35
LOCAL_LLM_N_CTX=4096

# API Keys (only needed if using API providers)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
GROQ_API_KEY=

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32

# Vector Database
VECTOR_DB_PATH=data/vector_indexes
FAISS_INDEX_TYPE=flat

# OCR Configuration
OCR_ENABLED=true
OCR_PRIMARY=paddleocr
OCR_FALLBACK=tesseract
OCR_CONFIDENCE_THRESHOLD=0.7
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Document Processing
MAX_FILE_SIZE_MB=50
MAX_PAGES=500
UPLOAD_DIR=uploads
TEMP_DIR=temp

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info
DEBUG=true

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=60

# Translation
TRANSLATION_PROVIDER=llm
# Options: llm, indictrans2
